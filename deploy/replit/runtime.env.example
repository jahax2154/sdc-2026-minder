# Set via Replit deployment Secrets. Names/examples only; never commit values.
MINDER_HOSTING_TARGET=replit
MINDER_DEPLOYMENT_KIND=reserved-vm
MINDER_ENV=production
MINDER_AUTH_MODE=managed
MINDER_AUTH_PROVIDER=clerk
MINDER_CLERK_INSTANCE_MODE=preview
MINDER_DOCUMENT_STORAGE=replit-app-storage
# Provider selects production DATABASE_URL during publication; preview uses managed
# development DB. Do not manually copy a development DSN into published Secrets.
# Explicit private bucket stays the same authorized project resource.
DATABASE_URL=
MINDER_DB_SCHEMA=minder
MINDER_DOCUMENT_STORAGE_BUCKET_ID=
MINDER_DOCUMENT_STORAGE_PREFIX=minder/private/
MINDER_RELEASE_SHA=
MINDER_JUDGE_URL=
PORT=8080
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional overrides: derive public issuer/signing PEM/origin at process start.
CLERK_ISSUER=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
CLERK_AUDIENCE=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
MINDER_LLM_DAILY_LIMIT=20
