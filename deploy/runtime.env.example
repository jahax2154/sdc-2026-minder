# Names/examples only. Configure values in the selected Railway service variables.
MINDER_ENV=production
MINDER_AUTH_MODE=managed
MINDER_AUTH_PROVIDER=clerk
# RAILWAY_VOLUME_MOUNT_PATH is provider supplied; attach the volume at /data.
MINDER_DATA_ROOT=/data
MINDER_DB_PATH=/data/minder/runtime.sqlite3
MINDER_DOCUMENT_STORAGE=private-volume
MINDER_DOCUMENT_STORAGE_ROOT=/data/minder/documents
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
MINDER_LLM_DAILY_LIMIT=20
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
# Optional; only set if the actual Clerk session includes the configured aud.
CLERK_AUDIENCE=
