{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minder:parallel:v1",
  "title": "Additive G0 service DTOs; does not approve pending numeric policy",
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_type": {
          "enum": [
            "source-derived",
            "policy-derived",
            "llm-proposed",
            "human-reviewed",
            "explicit-user",
            "document-claim",
            "synthetic-fixture"
          ]
        }
      },
      "required": [
        "source_id",
        "version",
        "sha256",
        "uri",
        "geography",
        "available_at",
        "evidence_type"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Source"
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_id",
        "subject_id",
        "value",
        "unit",
        "state",
        "provenance",
        "method_id"
      ]
    },
    "Preference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "enum": [
            "role",
            "industry"
          ]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "interested",
            "not_interested",
            "unknown"
          ]
        },
        "authorizing_request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity_type",
        "entity_id",
        "state",
        "authorizing_request_id"
      ]
    },
    "Constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "hard": {
          "type": "boolean"
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "constraint_id",
        "scope",
        "hard",
        "value",
        "unit",
        "evidence_id"
      ]
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_group_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "uniqueItems": true
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Preference"
          },
          "uniqueItems": true
        },
        "current_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field_id": {
                "type": "string",
                "minLength": 1
              },
              "field_type": {
                "enum": [
                  "industry",
                  "study",
                  "work"
                ]
              },
              "state": {
                "enum": [
                  "known",
                  "none_yet",
                  "unknown",
                  "want_to_leave"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "field_id",
              "field_type",
              "state",
              "evidence_ids"
            ]
          },
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "uniqueItems": true
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "profile_id",
        "profile_group_id",
        "version",
        "synthetic",
        "evidence",
        "preferences",
        "current_fields",
        "constraints",
        "timezone"
      ]
    },
    "Mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "source_accepted",
            "policy_accepted",
            "pending"
          ]
        }
      },
      "required": [
        "target_id",
        "source",
        "relation",
        "status"
      ]
    },
    "Role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role_id": {
          "type": "string",
          "minLength": 1
        },
        "taxonomy_id": {
          "type": "string",
          "minLength": 1
        },
        "taxonomy_version": {
          "type": "string",
          "minLength": 1
        },
        "database_version": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "eligibility": {
          "enum": [
            "supported",
            "partial",
            "invalid"
          ]
        },
        "industry_mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mapping"
          },
          "uniqueItems": true
        },
        "skill_mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mapping"
          },
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "uniqueItems": true
        },
        "missing_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "role_id",
        "taxonomy_id",
        "taxonomy_version",
        "database_version",
        "version",
        "label",
        "source",
        "eligibility",
        "industry_mappings",
        "skill_mappings",
        "requirements",
        "missing_reasons"
      ]
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "unit": {
          "const": "fraction_0_1"
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "missing_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "component_id",
        "value",
        "unit",
        "weight",
        "rule_id",
        "evidence_ids",
        "missing_reasons"
      ]
    },
    "Industry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "industry_id": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "preference_utility": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "assessment": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "missing_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "industry_id",
        "background",
        "preference_utility",
        "assessment",
        "rule_id",
        "evidence_ids",
        "missing_reasons"
      ]
    },
    "Gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "met",
            "gap",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "criterion_id",
        "state",
        "evidence_ids",
        "reason"
      ]
    },
    "PersonalAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "role_id": {
          "type": "string",
          "minLength": 1
        },
        "role_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_status": {
          "enum": [
            "accepted",
            "pending"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "scorer_kind": {
          "enum": [
            "baseline",
            "ridge",
            "xgboost"
          ]
        },
        "score_status": {
          "enum": [
            "scored",
            "insufficient_information",
            "policy_pending",
            "model_not_ready",
            "constraint_excluded"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "measurement": {
          "enum": [
            "personal_role_fit",
            "legacy_preparation_fit"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          },
          "uniqueItems": true
        },
        "industry_contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Industry"
          },
          "uniqueItems": true
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "uniqueItems": true
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "targeted_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "trace_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "role_id",
        "role_version",
        "policy_version",
        "policy_status",
        "model_version",
        "scorer_kind",
        "score_status",
        "score",
        "measurement",
        "components",
        "industry_contributions",
        "gaps",
        "prerequisites",
        "evidence_ids",
        "unknowns",
        "targeted_questions",
        "trace_rule_ids"
      ]
    },
    "Period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "MarketResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "enum": [
            "industry",
            "role",
            "skill"
          ]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "current",
            "forecast"
          ]
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "geography": {
          "const": "MY"
        },
        "source_universe_id": {
          "type": "string",
          "minLength": 1
        },
        "cohort_version": {
          "type": "string",
          "minLength": 1
        },
        "measurement": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation_period": {
          "$ref": "#/$defs/Period"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "available_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ingested_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "target_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ]
        },
        "horizon": {
          "enum": [
            "observed",
            "next_full_calendar_quarter"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "internal_index": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lower": {
              "type": [
                "number",
                "null"
              ]
            },
            "upper": {
              "type": [
                "number",
                "null"
              ]
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "lower",
            "upper",
            "method"
          ]
        },
        "missing_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity_type",
        "entity_id",
        "kind",
        "status",
        "geography",
        "source_universe_id",
        "cohort_version",
        "measurement",
        "unit",
        "denominator",
        "observation_period",
        "published_at",
        "available_at",
        "ingested_at",
        "issued_at",
        "target_period",
        "horizon",
        "value",
        "internal_index",
        "uncertainty",
        "missing_reasons",
        "source_ids",
        "model_version",
        "explanation"
      ]
    },
    "PublicOption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role_id": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "personal_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "score_status": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "role_id",
        "rank",
        "personal_score",
        "score_status",
        "explanation",
        "source_ids",
        "unknowns"
      ]
    },
    "PublicRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "minder-parallel-v1"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "market_period_policy_key": {
          "enum": [
            "personal_only_pending_market_policy",
            "current_only",
            "next_calendar_quarter"
          ]
        },
        "status": {
          "enum": [
            "available",
            "partial",
            "policy_pending",
            "unavailable"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicOption"
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "contract_version",
        "profile_id",
        "profile_version",
        "policy_version",
        "model_version",
        "candidate_ids",
        "market_period_policy_key",
        "status",
        "options",
        "limitations"
      ]
    },
    "Recommendation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": {
          "$ref": "#/$defs/PublicRecommendation"
        },
        "internal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "personal_assessments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PersonalAssessment"
              },
              "uniqueItems": true
            },
            "current_market": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MarketResult"
              },
              "uniqueItems": true
            },
            "forecast_market": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MarketResult"
              },
              "uniqueItems": true
            },
            "combined_score_policy_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "combined_scores": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "role_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "role_id",
                  "score"
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "personal_assessments",
            "current_market",
            "forecast_market",
            "combined_score_policy_version",
            "combined_scores"
          ]
        }
      },
      "required": [
        "public",
        "internal"
      ]
    },
    "CompanyRoleResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "employer_id": {
          "type": "string",
          "minLength": 1
        },
        "employer_name": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "role_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "found",
            "no_role_found_in_checked_sources",
            "requirements_unavailable"
          ]
