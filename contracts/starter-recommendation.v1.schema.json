{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minder:starter-exploration:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "const": "starter-exploration-v1"
    },
    "mode": {
      "const": "starter"
    },
    "status": {
      "enum": [
        "provisional",
        "restriction_review_required"
      ]
    },
    "profile_version": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "matched_topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/Source"
            }
          },
          "requirements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "const": "role-display-v1"
              },
              "role_id": {
                "type": "string"
              },
              "role_label": {
                "type": "string"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "subject_id": {
                      "type": "string"
                    },
                    "label": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "label_status": {
                      "enum": [
                        "available",
                        "unavailable"
                      ]
                    },
                    "label_source": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/Source"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "measurements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "evidence_id": {
                            "type": "string"
                          },
                          "unit": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "explanation": {
                            "type": "string"
                          },
                          "value": {},
                          "availability": {
                            "enum": [
                              "available",
                              "unavailable"
                            ]
                          },
                          "source": {
                            "$ref": "#/$defs/Source"
                          }
                        },
                        "required": [
                          "evidence_id",
                          "unit",
                          "label",
                          "explanation",
                          "value",
                          "availability",
                          "source"
                        ]
                      }
                    },
                    "personal_evidence": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "not_assessed",
                            "recorded_unassessed",
                            "anchored_evidence_recorded",
                            "needs_clarification"
                          ]
                        },
                        "recorded_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "anchored_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "assessment_kinds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "evidence_ids": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "explanation": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "status",
                        "recorded_count",
                        "anchored_count",
                        "assessment_kinds",
                        "evidence_ids",
                        "explanation"
                      ]
                    }
                  },
                  "required": [
                    "subject_id",
                    "label",
                    "label_status",
                    "label_source",
                    "measurements",
                    "personal_evidence"
                  ]
                }
              },
              "source_record_count": {
                "type": "integer",
                "minimum": 0
              },
              "skill_count": {
                "type": "integer",
                "minimum": 0
              },
              "explanation": {
                "type": "string"
              },
              "measurement_rule": {
                "type": "string"
              }
            },
            "required": [
              "version",
              "role_id",
              "role_label",
              "skills",
              "source_record_count",
              "skill_count",
              "explanation",
              "measurement_rule"
            ]
          },
          "market_evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "market_evidence_status": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "market_comparison_supported": {
            "type": "boolean"
          },
          "personal_assessment": {
            "type": "null"
          },
          "status": {
            "const": "provisional"
          }
        },
        "required": [
          "role_id",
          "label",
          "explanation",
          "matched_topics",
          "sources",
          "requirements",
          "market_evidence",
          "market_evidence_status",
          "market_comparison_supported",
          "personal_assessment",
          "status"
        ]
      }
    },
    "personal_assessment": {
      "type": "null"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported_considered": {
          "type": "integer",
          "minimum": 0
        },
        "after_explicit_restrictions": {
          "type": "integer",
          "minimum": 0
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "assessed_personal_scores": {
          "const": 0
        },
        "returned_with_supported_market_comparison": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "supported_considered",
        "after_explicit_restrictions",
        "returned",
        "assessed_personal_scores",
        "returned_with_supported_market_comparison"
      ]
    },
    "unresolved_constraint_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprioritized_role_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "further_exploration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "/api/roles"
        },
        "catalogue_order_not_rank": {
          "const": true
        }
      },
      "required": [
        "path",
        "catalogue_order_not_rank"
      ]
    },
    "planning_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weekly_study_hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "experience_state": {
          "enum": [
            "none_yet",
            "provided",
            "uncertain"
          ]
        }
      },
      "required": [
        "weekly_study_hours",
        "experience_state"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "policy_version",
    "mode",
    "status",
    "profile_version",
    "options",
    "personal_assessment",
    "coverage",
    "unresolved_constraint_ids",
    "deprioritized_role_ids",
    "further_exploration",
    "planning_input",
    "limitations"
  ],
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_type": {
          "enum": [
            "source-derived",
            "policy-derived",
            "llm-proposed",
            "human-reviewed",
            "explicit-user",
            "document-claim",
            "synthetic-fixture"
          ]
        }
      },
      "required": [
        "source_id",
        "version",
        "sha256",
        "uri",
        "geography",
        "available_at",
        "evidence_type"
      ]
    }
  }
}
